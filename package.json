{
    "name": "game-template",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "description": "Reusable cross-platform game starter for web, itch.io, Capacitor and Electron.",
    "author": "GameBob",
    "engines": {
        "node": ">=22.18.0 <23"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "qa": "npm run check && npm run test && npm run build",
        "minor": "node scripts/release.mjs minor",
        "init": "node scripts/init-game.mjs",
        "itch:package": "node scripts/package-itch.mjs",
        "itch:preview": "node scripts/preview-itch.mjs",
        "electron:dev": "node scripts/electron-dev.mjs",
        "electron:build": "npm run build && electron-builder --dir",
        "electron:dist": "npm run build && electron-builder",
        "cap:add:android": "cap add android",
        "cap:add:ios": "cap add ios",
        "cap:sync": "npm run build && cap sync",
        "cap:open:android": "cap open android",
        "cap:open:ios": "cap open ios"
    },
    "dependencies": {
        "@capacitor/core": "7.6.9"
    },
    "devDependencies": {
        "@capacitor/android": "7.6.9",
        "@capacitor/cli": "7.6.9",
        "@capacitor/ios": "7.6.9",
        "@types/node": "22.20.3",
        "@vitest/coverage-v8": "3.2.7",
        "archiver": "7.0.1",
        "electron": "36.9.5",
        "electron-builder": "26.15.3",
        "typescript": "5.9.3",
        "vite": "6.4.3",
        "vitest": "3.2.7"
    },
    "build": {
        "appId": "com.gamebob.game",
        "productName": "Game Template",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage"
        }
    }
}
